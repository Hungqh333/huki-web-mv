# Sao chép file này thành .env.local và điền giá trị thật.
# Copy this file to .env.local and fill in the real values.
# Lấy giá trị tại: Supabase Dashboard → Project Settings → API

# URL của project Supabase (public, an toàn để lộ ra client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/public key — dùng ở browser, luôn đi kèm Row Level Security
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — CHỈ dùng phía server (migration, seed, admin task).
# TUYỆT ĐỐI không đặt tiền tố NEXT_PUBLIC_ và không commit giá trị thật.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL gốc của site, dùng cho redirect sau khi xác thực email
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Địa chỉ nhận yêu cầu tư vấn từ các nút "Liên hệ".
# Bỏ trống thì dùng mặc định hungnv@soragroup.vn (xem src/lib/contact.ts).
CONTACT_EMAIL=hungnv@soragroup.vn
